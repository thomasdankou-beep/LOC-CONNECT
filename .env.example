# Base de données PostgreSQL
DATABASE_URL="postgresql://locconnect:locconnect@localhost:5432/locconnect?schema=public"
# Base utilisée par les tests d'intégration (vitest)
DATABASE_URL_TEST="postgresql://locconnect:locconnect@localhost:5432/locconnect_test?schema=public"

# Session : secret d'au moins 32 caractères (openssl rand -base64 48)
AUTH_SECRET="remplacez-moi-par-un-secret-long-et-aleatoire-32-caracteres-min"
SESSION_TTL_HOURS="168"

# URL publique du site (liens dans les e-mails, vérification d'origine CSRF)
APP_URL="http://localhost:3000"

# Paiement : "simulated" (démo, aucun vrai paiement) ou un fournisseur réel branché dans services/payments/providers
PAYMENT_PROVIDER="simulated"
# Secret de signature des webhooks de paiement
PAYMENT_WEBHOOK_SECRET="remplacez-moi-par-un-secret-webhook-32-caracteres"

# Stockage des fichiers : "local" ou "s3"
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# E-mail (optionnel : sans SMTP, les e-mails sont journalisés en base uniquement)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="LOC'CONNECT <no-reply@locconnect.example>"

# Tâches planifiées (expiration des HOLD, escalades, versements) : en-tête Authorization: Bearer <CRON_SECRET>
CRON_SECRET="remplacez-moi-par-un-secret-cron"

# Mot de passe des comptes de démonstration créés par le seed
SEED_DEMO_PASSWORD="Demo2026!Loc"
